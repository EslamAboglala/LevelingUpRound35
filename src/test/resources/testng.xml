<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LevelingUpRound35">
    <test name="ChromeTests">
        <parameter name="browser" value="chrome"/>
        <parameter name="duckDuckGoUrl" value="https://duckduckgo.com/"/>
        <parameter name="checkboxesUrl" value="http://the-internet.herokuapp.com/checkboxes"/>
        <parameter name="w3SchoolsHtmlTableUrl" value="https://www.w3schools.com/html/html_tables.asp"/>
        <parameter name="fileUploadUrl" value="http://the-internet.herokuapp.com/upload"/>
        <parameter name="jQueryUiDroppableUrl" value="https://jqueryui.com/resources/demos/droppable/default.html"/>
        <parameter name="uploadImageResourcePath" value="images/upload-test.png"/>
        <classes>
            <class name="mohabtasks.JQueryUiDroppableTest"/>
            <class name="mohabtasks.FileUploadTest"/>
            <class name="mohabtasks.CheckboxesTest"/>
            <class name="mohabtasks.W3SchoolsHtmlTableTest"/>
            <class name="mohabtasks.DuckDuckGoPageTest">
                <methods>
                    <include name="shouldAssertGooglePageTitle"/>
                    <include name="shouldDisplayDuckDuckGoLogo"/>
                    <include name="shouldShowSeleniumWebDriverDocumentationAsFirstSearchResult"/>
                    <include name="shouldShowLinkedInAsSecondCucumberIoSearchResult"/>
                </methods>
            </class>
            <class name="mohabtasks.drivers.BrowserFactoryTest"/>
        </classes>
    </test>
    <test name="FirefoxTestNGSearch">
        <parameter name="browser" value="firefox"/>
        <parameter name="duckDuckGoUrl" value="https://duckduckgo.com/"/>
        <classes>
            <class name="mohabtasks.DuckDuckGoPageTest">
                <methods>
                    <include name="shouldShowTestNgTutorialAsFourthSearchResultInFirefox"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>